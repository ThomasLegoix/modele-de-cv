{
  "name": "Portfolio UniLaSalle Amiens",
  "image": "mcr.microsoft.com/devcontainers/ruby:3",

  "onCreateCommand": "bundle install",
  "postStartCommand": "bundle exec jekyll serve --livereload",

  "customizations": {
    "vscode": {
      "extensions": [
        // --- JEKYLL ---
        "ginfuru.ginfuru-vscode-jekyll-syntax", // Coloration syntaxique Jekyll/Liquid
        "ginfuru.vscode-jekyll-snippets",       // Raccourcis pour les balises Liquid (for, if, etc.)
        
        // --- ÉDITION MARKDOWN ---
        "yzhang.markdown-all-in-one",          // Raccourcis clavier (gras, listes) et table des matières
        "DavidAnson.vscode-markdownlint",       // Guide l'étudiant pour écrire un Markdown propre
        "shaneharper.markdown-table-formatter", // Aligne les tableaux automatiquement (très utile !)
        
        // --- OUTILS DE CONFORT ---
        "streetsidesoftware.code-spell-checker", // Évite les fautes de frappe (anglais/français)
        "christian-kohler.path-intellisense",    // Auto-complétion des chemins d'images/fichiers
        "eamodio.gitlens"                        // Pour voir qui a modifié quoi (pédagogique)
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.wordWrap": "on",                // Évite le défilement horizontal en Markdown
        "markdownlint.config": {
            "MD013": false                      // Désactive la limite de longueur de ligne
        }
      }
    }
  },

  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Aperçu du site",
      "onAutoForward": "openBrowser"
    }
  }
}